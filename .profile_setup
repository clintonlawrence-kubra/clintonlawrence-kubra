# Clear-cut Homebrew JDK Switcher for your custom profile setup
jdk() {
    if [ -z "$1" ]; then
        echo "Current Java version:"
        java -version
        echo "\nAvailable Homebrew OpenJDKs:"
        ls -d /opt/homebrew/opt/openjdk* 2>/dev/null | awk -F'/' '{print $NF}'
    else
        # Determine target path directly from Homebrew's cellars
        local target_path=""
        if [ "$1" = "latest" ] || [ "$1" = "26" ]; then
            # Handles default 'openjdk' installation (which is your version 26)
            target_path="/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home"
        else
            # Handles explicitly versioned cellars (like openjdk@25)
            target_path="/opt/homebrew/opt/openjdk@$1/libexec/openjdk.jdk/Contents/Home"
        fi

        # Check if the folder physically exists before trying to switch
        if [ -d "$target_path" ]; then
            export JAVA_HOME="$target_path"
            
            # Clean any old JDK paths from your active PATH variable
            PATH=$(echo "$PATH" | tr ':' '\n' | grep -v 'opt/openjdk' | tr '\n' ':' | sed 's/:$//')
            
            # Prepend the true, absolute binary track to the absolute front of PATH
            export PATH="$JAVA_HOME/bin:$PATH"
            
            echo "Switched to Java $1"
            java -version
        else
            echo "Error: Homebrew OpenJDK version '$1' not found at:"
            echo " -> $target_path"
        fi
    fi
}






function checkoutBranch() {
    local branchName=$1
    if [[ -z "$branchName" ]]; then
        echo "Usage: checkoutBranch <branch-name>"
        bail_on_fail 1 exit
    fi

    git checkout $branchName
    local bailed=$(bail_on_fail $? return)

    if [[ $bailed -ne 0 ]]; then
        defaultBranch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')
        echo "Branch $branchName doesn't exist. Attempting to create"
        
        git checkout $defaultBranch #always get from default to ensure we have the latest changes before switching branches
        checkoutStatus=$(bail_on_fail $? return)
        echo $defaultBranch checkout status: $checkoutStatus

        git pull

        git checkout -b $branchName
        bail_on_fail $? exit 
        echo "Successfully created and checked out branch $branchName"
    else
        echo "Successfully checked out branch $branchName"
        git pull
        bail_on_fail $? exit  
        echo "Successfully pulled latest changes for branch $branchName"
    fi
}
_checkoutBranch_completions() { 
  # 1. Fetch all branches into a Zsh array
  local branches=($(git branch --all --format='%(refname:short)' 2>/dev/null)) 
  
  # 2. Strip "origin/" from the front of any matching elements
  branches=(${branches#origin/})
  
  # 3. Pass the cleaned array to compadd
  compadd -a branches 
} 


# Register for the checkoutBranch command
compdef _checkoutBranch_completions checkoutBranch