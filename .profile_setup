function bail_on_fail() {
    local shouldExit=$2
    if [ $1 -ne 0 ]; then
        echo "Error: Command failed with exit code $1 $2" >&2
        if [[ "$shouldExit" == "exit" ]]; then
            echo "Exiting due to failure...Press any key to continue." >&2
            read -n 1 -s
            exit 1
        elif [[ "$shouldExit" == "return" ]]; then
            echo 1
            return 1
        fi
    fi
    echo 0
    return 0
}

function copyCurrentBranchName() {
    local branchName=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -n "$branchName" ]]; then
        echo -n "$branchName" | pbcopy
        echo "Current branch name '$branchName' copied to clipboard."
    else
        echo "Not in a git repository or unable to determine branch name."
    fi
}

function mergeBranch(){
    mergeBranchName=$1
    if [[ -z "$mergeBranchName" ]]; then
        echo "Usage: mergeBranch <branch-name>"
        bail_on_fail 1 exit
    fi
    git merge $mergeBranchName
    bail_on_fail $? exit
}

function openRepo()
{
    reposDir=~/repos
    curDir=$(pwd)
    repoDir="$reposDir/$1"
    [[ -d "$repoDir" ]] && repoExists="yes" || repoExists="no"
    echo "Does the repo $1 exist? $repoExists"

    if [[ $repoExists == "no" ]]; then
        gh repo clone kubra-hq/$1 $repoDir
        #if not exist check iFactor owner        
        if [[ $? -ne 0 ]]; then
            echo "Failed to clone from kubra-hq. Attempting to clone from iFactor..."
            gh repo clone iFactor/$1 $repoDir
            if [[ $? -ne 0 ]]; then
                echo "Failed to clone from both kubra-hq and iFactor. Attempting Clone from Kubra AWS Management..."
                gh repo clone KUBRA-AWS-Management/$1 $repoDir
                if [[ $? -ne 0 ]]; then
                    echo "Failed to clone from Kubra AWS Management as well.  Attempting Clone from kubra-shared-services..."
                    gh repo clone kubra-shared-services/$1 $repoDir
                    if [[ $? -ne 0 ]]; then
                        echo "Failed to clone from kubra-shared-services as well. Please check the repository name or your access permissions."
                        bail_on_fail 1 exit
                    fi
                fi
            fi
        fi
    else
        cd $repoDir
        git pull
        #Branch no longer exists so need to checkout develop or main
        if [[ $? -ne 0 ]]; then
            echo "Failed to pull latest changes. Attempting to checkout develop branch..."
            git checkout develop
            if [[ $? -ne 0 ]]; then
                echo "Failed to checkout develop branch. Attempting to checkout main branch..."
                git checkout main
                if [[ $? -ne 0 ]]; then
                    echo "Failed to checkout both develop and main branches. Attempting to checkout master branch..."
                    git checkout master
                    if [[ $? -ne 0 ]]; then
                        echo "Failed to checkout any trunk branch. Please check the repository state."
                        bail_on_fail 1 exit
                    fi
                fi
            fi
        fi  
    fi
    
    bail_on_fail $? exit
    
    echo "Successfully opened repo $1"
    code $repoDir

    
    cd $curDir
    
}
_openRepo_completions() {
