function gitSquash() {
    git reset --soft origin/develop
}

function gitRevertSquash() {
    git reset 'HEAD@{1}'
}

function gitPushSquash() {
    git push origin HEAD --force-with-lease
}

function gitResetBranch() {
    git reset --hard origin/$(git rev-parse --abbrev-ref HEAD)
}

function gitCleanBranches() {
    git remote prune origin
    git fetch -p
    git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
}

function gitRenameBranch() {
    local newBranchName=$1
    if [[ -z "$newBranchName" ]]; then
        echo "Usage: gitRenameBranch <new-branch-name>"
        bail_on_fail 1 exit
    fi

    local currentBranch=$(git rev-parse --abbrev-ref HEAD)
    
    if [[ "$currentBranch" == "$newBranchName" ]]; then
        echo "Current branch is already named $newBranchName"
        return 0
    fi

    git branch -m $newBranchName
    bail_on_fail $? exit
    
    echo "Successfully renamed branch to $newBranchName"
}

