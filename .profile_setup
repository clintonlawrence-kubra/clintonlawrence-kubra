function bail_on_fail() {
    local shouldExit=$2
    if [ $1 -ne 0 ]; then
        echo "Error: Command failed with exit code $1 $2"
        if [[ "$shouldExit" == "exit" ]]; then
            exit 1
        elif [[ "$shouldExit" == "return" ]]; then
            return 1
        fi
    fi
    return 0
}

function copyCurrentBranchName() {
    local branchName=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -n "$branchName" ]]; then
        echo -n "$branchName" | pbcopy
        echo "Current branch name '$branchName' copied to clipboard."
    else
        echo "Not in a git repository or unable to determine branch name."
    fi
}

function mergeBranch(){
    mergeBranchName=$1
    if [[ -z "$mergeBranchName" ]]; then
        echo "Usage: mergeBranch <branch-name>"
        return 1
    fi
    git merge $mergeBranchName
    bail_on_fail $? exit
}

function openRepo()
{
    reposDir=~/repos
    curDir=$(pwd)
    repoDir="$reposDir/$1"
    [[ -d "$repoDir" ]] && repoExists="yes" || repoExists="no"
    echo "Does the repo $1 exist? $repoExists"

    if [[ $repoExists == "no" ]]; then
        gh repo clone kubra-hq/$1 $repoDir
    else
        cd $repoDir
        git pull
    fi
    
    bail_on_fail $? exit
    
    echo "Successfully opened repo $1"
    code $repoDir

    
    cd $curDir
    
}
_openRepo_completions() {
    local reposDir=~/repos
    # Check if directory exists to avoid errors
    if [[ -d "$reposDir" ]]; then
        # -W specifies the parent directory to look into
        # / is the suffix added to matches
        _path_files -W "$reposDir" -/
    fi
}

# Register for the openRepo command
compdef _openRepo_completions openRepo

source <(kubectl completion zsh)



function checkoutBranch() {
    local branchName=$1
    if [[ -z "$branchName" ]]; then
        echo "Usage: checkoutBranch <branch-name>"
        return 1
    fi

    git checkout $branchName
    bail_on_fail $? return
    
    local bailed=$?
    
    if [[ $bailed -ne 0 ]]; then
        echo "Branch $branchName doesn't exist. Attempting to create"
        
        git checkout main #always get from main to ensure we have the latest changes before switching branches
        git pull

        git checkout -b $branchName
        bail_on_fail $? exit 
        echo "Successfully created and checked out branch $branchName"
    else
        echo "Successfully checked out branch $branchName"
        git pull
        bail_on_fail $? exit  
        echo "Successfully pulled latest changes for branch $branchName"
    fi
}
_checkoutBranch_completions() { 
  # 1. Fetch all branches into a Zsh array
  local branches=($(git branch --all --format='%(refname:short)' 2>/dev/null)) 
  
  # 2. Strip "origin/" from the front of any matching elements
  branches=(${branches#origin/})
  
  # 3. Pass the cleaned array to compadd
  compadd -a branches 
} 


# Register for the checkoutBranch command
compdef _checkoutBranch_completions checkoutBranch