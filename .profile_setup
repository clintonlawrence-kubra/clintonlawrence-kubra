autoload -Uz compinit && compinit
alias resetProfile="source /Users/clawrence/.zprofile"

function bail_on_fail() {
    if [ $1 -ne 0 ]; then
        echo "Error: Command failed with exit code $1"
        return 1
    fi
    return 0
}

function openRepo()
{
    reposDir=~/repos
    curDir=$(pwd)
    repoDir="$reposDir/$1"
    [[ -d "$repoDir" ]] && repoExists="yes" || repoExists="no"
    echo "Does the repo $1 exist? $repoExists"

    if [[ $repoExists == "no" ]]; then
        gh repo clone kubra-hq/$1 $repoDir
    else
        cd $repoDir
        git pull
    fi
    
    bail_on_fail $?
    
    local bailed=$?
    
    if [[ $bailed -ne 0 ]]; then
        return $bailed
    else
        echo "Successfully opened repo $1"
        code $repoDir
    fi
    
    cd $curDir
    
}
_openRepo_completions() {
    local reposDir=~/repos
    # Check if directory exists to avoid errors
    if [[ -d "$reposDir" ]]; then
        # -W specifies the parent directory to look into
        # / is the suffix added to matches
        _path_files -W "$reposDir" -/
    fi
}

# Register for the openRepo command
compdef _openRepo_completions openRepo

